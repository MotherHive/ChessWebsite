{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "chess-website-staging",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "chess-website-staging"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "E2E_TESTING": "true",
    "SITE_URL": "https://staging.scrantonchess.org",
    "RESEND_FROM": "Scranton Chess Club <noreply@scrantonchess.org>",
    "ADMIN_EMAILS": "cianwknight@gmail.com,scrantonchess@gmail.com",
    "CLOUDFLARE_ACCESS_TEAM_DOMAIN": "https://gentle-union-defe.cloudflareaccess.com",
    "CLOUDFLARE_ACCESS_AUD": "53c45149e7a7a309d6a625e01ef1818c496963a2d980db68b0f0e9aa3acffc29"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chess-website-staging-db",
      "database_id": "69f5dd73-be10-4fe3-ac8f-d8642120a2d7",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TOURNAMENT_IMAGES",
      "bucket_name": "chess-website-staging-images"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_FORM_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 20,
        "period": 10
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
