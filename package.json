{
  "name": "chess-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "stripe:sandbox:configure": "node scripts/configure-stripe-sandbox.mjs",
    "stripe:staging:webhook": "node scripts/configure-stripe-staging-webhook.mjs",
    "staging:deploy": "opennextjs-cloudflare build && wrangler deploy --config wrangler.staging.jsonc",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@vercel/analytics": "^2.0.1",
    "jose": "^6.2.8",
    "next": "^16.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "resend": "^6.12.4",
    "stripe": "^22.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "wrangler": "^4.122.0"
  }
}
