{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "chess-website",
	"compatibility_date": "2026-08-12",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "chess-website"
		}
	],
	// Non-secret configuration. Secrets (Stripe, Resend, Turnstile) are set with
	// `wrangler secret put` and must never appear here.
	"vars": {
		"SITE_URL": "https://scrantonchess.org",
		"ADMIN_EMAILS": "cianwknight@gmail.com,scrantonchess@gmail.com,bwisenburn@maryu.marywood.edu,basp0529@gmail.com",
		"CLOUDFLARE_ACCESS_TEAM_DOMAIN": "https://gentle-union-defe.cloudflareaccess.com",
		"CLOUDFLARE_ACCESS_AUD": "036fc36ff624529c9f6998cf085b9a94a3db98030ff2773773d72300dd837c1d"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "chess-website-db",
			"database_id": "f7fb2f33-a80a-4dd8-956e-be044d2f2d9d",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "TOURNAMENT_IMAGES",
			"bucket_name": "chess-website-tournament-images"
		}
	],
	"ratelimits": [
		{
			"name": "PUBLIC_FORM_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 10
			}
		}
	],
	"observability": {
		"enabled": true
	},
	"images": {
		"binding": "IMAGES"
	}
}